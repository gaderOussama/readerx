{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaderX",
  "version": "0.1.0",
  "identifier": "com.readerx.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReaderX",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "visible": false,
        "backgroundColor": "#F4F1EA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis"],
    "publisher": "ReaderX",
    "shortDescription": "A bookshelf that reopens every book where you left it",
    "nsis": {
      "installMode": "currentUser"
    }
  }
}
