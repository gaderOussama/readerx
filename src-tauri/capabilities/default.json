{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "opener:allow-open-url",
    "window-state:default",
    "allow-get-state",
    "allow-choose-folder",
    "allow-dismiss-notice",
    "allow-open-book",
    "allow-save-position",
    "allow-set-meta",
    "allow-save-cover",
    "allow-set-finished",
    "allow-set-page-theme",
    "allow-set-epub-settings",
    "allow-set-dim-desktop",
    "allow-dim-desktop",
    "allow-get-highlights",
    "allow-add-highlights",
    "allow-set-note",
    "allow-delete-highlight",
    "allow-restore-highlight",
    "allow-forget-undo",
    "allow-set-export-folder"
  ]
}
